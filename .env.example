# Copy to .env and fill in values. Never commit the real .env.

# LiteLLM admin
LITELLM_MASTER_KEY=sk-change-me-long-random
LITELLM_SALT_KEY=sk-change-me-once-and-never-again
UI_USERNAME=admin
UI_PASSWORD=change-me

# PostgreSQL
# On Railway the app service uses the private URL:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}  (rewrite path to /litellm)
# Locally, run scripts/db-tunnel.sh then:
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:15432/litellm
LITELLM_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:15432/litellm
OPENWEBUI_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:15432/openwebui

STORE_MODEL_IN_DB=True

# Upstream provider keys — server-side only. Never give these to employees.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MIMO_API_KEY=

# Optional premium fallbacks (off by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Open WebUI
WEBUI_SECRET_KEY=change-me-64-hex
WEBUI_ADMIN_PASSWORD=change-me
OPENWEBUI_BOOTSTRAP_KEY=sk-change-me-long-random

LITELLM_PORT=4000
OPENWEBUI_PORT=3000
PG_TUNNEL_PORT=15432

# Public URLs (set after first Railway deploy)
PUBLIC_GATEWAY_URL=https://gateway.example.com
PUBLIC_CHAT_URL=https://ai.example.com
